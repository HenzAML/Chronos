# --- Local development ---
# Native Homebrew Postgres, no Docker needed:
#   brew install postgresql@15 && brew services start postgresql@15
#   createdb chronos
DATABASE_URL=postgresql://<your-mac-username>@localhost:5432/chronos

# --- Production (Hetzner VPS) ---
# Self-hosted Postgres on the VPS; same migrations as local.
# DATABASE_URL=postgresql://chronos:<password>@<vps-host>:5432/chronos

JWT_SECRET=changeme

# Backend dev server port. 5000 is occupied by macOS AirPlay Receiver.
PORT=5001
